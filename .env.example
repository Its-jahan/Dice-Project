# All of these are OPTIONAL.
#
# The usual way to configure DICE is the web UI: the Dune API key and the
# Telegram credentials saved there live in the server's SQLite database and
# take precedence. The environment variables below act as fallbacks.

# DUNE_API_KEY=
# DUNE_API_BASE=https://api.dune.com/api/v1

# If you saved a parametrised holder query in Dune, put its id here and DICE
# will execute it (with blockchain / token_address / start_date / end_date /
# minimum_balance parameters) instead of creating an ad-hoc query.
# DUNE_QUERY_ID=

# Seconds to wait for a Dune execution before giving up.
# DICE_EXECUTION_TIMEOUT=900
# DICE_POLL_INTERVAL=2.0

# Hard cap on rows pulled back from Dune.
# DICE_MAX_ROWS=1000000

# --------------------------- watchlist monitoring ---------------------------

# SQLite file holding watchlists, monitor runs and signals.
# Defaults to backend/data/dice.db; the systemd deployment sets
# /var/lib/dice/dice.db instead (see deploy/dice.service).
# DICE_DB_PATH=

# Master switch for the background scheduler (default: enabled). Scheduled
# runs also need DUNE_API_KEY above — with no server key they simply idle and
# only the UI's "Run now" button (browser key) triggers monitor runs.
# DICE_MONITOR_ENABLED=true

# How often the scheduler looks for due watchlists, in seconds.
# DICE_MONITOR_TICK_SECONDS=60

# Cap on wallets monitored per watchlist. Every address is written into the
# generated trades query, so keep this in the low thousands.
# DICE_MONITOR_MAX_WALLETS=2000

# Telegram push for new/strengthened signals. Normally configured from the
# UI's "Telegram alerts" card; these are env fallbacks. Create a bot with
# @BotFather, put its token here, and the chat id of the chat that should
# receive alerts (message @userinfobot to find yours).
# DICE_TELEGRAM_BOT_TOKEN=
# DICE_TELEGRAM_CHAT_ID=

# Public HTTPS origin of this deployment, e.g. https://dice.example.com.
# Alchemy delivers webhooks to <origin>/api/webhooks/alchemy, so it must be
# reachable from the internet. Normally set in the UI's "Live monitoring"
# card; this is the fallback. The Alchemy auth token is UI-only.
# DICE_PUBLIC_URL=

# How often the live sweep re-checks stored buys against each live watchlist's
# threshold, catching signals no new delivery would announce (threshold
# lowered, wallets added later). Reads local SQLite only, so it is cheap.
# DICE_LIVE_SWEEP_SECONDS=300

# Minimum pooled liquidity, in USD, before a token may produce a signal.
# Checked against DexScreener (free, no key). Even 0 still requires a pool to
# exist at all, which is what excludes spam tokens that were never tradeable.
# DICE_MIN_LIQUIDITY_USD=1000

# Pooled live signals: every live watchlist's wallets form one set, and a
# token fires when this share of that pool acquired it. Editable in the UI.
# DICE_POOL_PCT=10
# DICE_POOL_MIN_WALLETS=3

# Whether wallets that were handed a token (rather than paying for it) count
# towards a signal. Safe on, because tokens with no liquidity pool are
# dropped either way; signals stay labelled bought / airdrop / mixed.
# DICE_SIGNAL_AIRDROPS=true
